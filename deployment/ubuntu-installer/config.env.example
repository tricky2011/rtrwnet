# Copy file ini KE LUAR source tree, misalnya:
#   cp deployment/ubuntu-installer/config.env.example /root/rtrwnet-installer.env
# Lalu jalankan installer dengan:
#   RTRWNET_INSTALLER_CONFIG=/root/rtrwnet-installer.env sudo bash install.sh
#
# Jangan simpan config yang berisi secret di dalam SOURCE_ROOT karena installer
# final akan hard-fail jika build context mengandung file config live.

# Nama aplikasi untuk ringkasan akhir installer.
APP_NAME="RTRWNet Production"

# Root source code yang bersih dan aman untuk dipaketkan.
# SOURCE_ROOT harus berbeda dari APP_ROOT dan tidak boleh berisi .env live
# atau runtime artefact.
SOURCE_ROOT="/opt/rtrwnet-source"

# Domain utama untuk server_name Nginx.
APP_DOMAIN="rtrwnet.example.com"

# Alias server_name tambahan, pisahkan dengan spasi jika perlu.
APP_SERVER_ALIASES=""

# Root deploy target production.
# APP_ROOT harus kosong pada fresh install pertama.
APP_ROOT="/var/www/rtrwnet"

# Nama file config Nginx di /etc/nginx/sites-available/.
NGINX_CONF_NAME="rtrwnet.conf"

# auto = default_server hanya aktif jika APP_DOMAIN berupa IP/localhost.
# 1    = paksa default_server/by-IP mode.
# 0    = host-based routing only.
NGINX_ENABLE_DEFAULT_SERVER="auto"

# Target utama:
# - Ubuntu 22.04 -> 8.1
# - Ubuntu 24.04 -> 8.3
# Kosongkan untuk memakai default Ubuntu yang didukung di atas.
PHP_VERSION=""

# Opsional override socket PHP-FPM. Kosongkan agar installer mendeteksi dari
# pool config Ubuntu yang aktif.
PHP_FPM_SOCK=""

# Kosongkan agar installer memilih /usr/bin/php<VERSION> atau php aktif.
PHP_BIN=""

# Runtime environment aplikasi.
CI_ENV="production"

# User/group proses web dan worker.
WEB_USER="www-data"
WEB_GROUP="www-data"

# Database aplikasi.
# 127.0.0.1 / localhost / ::1 = installer akan menyiapkan MySQL lokal.
# Host lain = installer hanya memasang mysql client dan memverifikasi koneksi.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="rtrwnet_prod"
DB_USER="rtrwnet_app"
DB_PASS="Ganti-Dengan-Password-App-2026!"

# Kosongkan jika ingin root database tetap memakai auth_socket/local auth.
DB_ROOT_PASS=""

# Seed SQL/schema final harus diletakkan di LUAR SOURCE_ROOT.
# Kosongkan jika Anda yakin migration + schema existing sudah cukup.
SQL_FILE=""

# Jalankan migration latest setelah env + DB siap.
ENABLE_DB_MIGRATIONS="1"

# auto = installer mendeteksi controller migration CLI dari source tree.
# Isi manual bila route proyek berbeda, misalnya: migrate latest
MIGRATION_COMMAND="auto"

# Secret runtime minimum. Kosongkan agar digenerate saat install pertama.
CI_ENCRYPTION_KEY=""
PROVISIONING_CALLBACK_SECRET=""
TELEGRAM_WEBHOOK_SECRET=""
CRON_TOKEN=""
MONITORING_CRON_TOKEN=""

# Optional Telegram bot token.
TELEGRAM_BOT_TOKEN=""

# Keputusan queue/Redis.
# 1 = aktifkan queue driver redis
# 0 = fallback resmi ke queue driver database
ENABLE_REDIS="0"
# 127.0.0.1 / localhost / ::1 = installer akan menyiapkan redis-server lokal.
# Host lain = installer hanya memasang redis-tools + php redis ext lalu
# memverifikasi koneksi ke Redis remote.
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_DB="0"
REDIS_PASSWORD=""
REDIS_PREFIX="rtrwnet:"

# Worker background wajib aktif bila cron project diaktifkan.
ENABLE_WORKER="1"
WORKER_SERVICE_NAME="rtrwnet-worker.service"

# Cron file /etc/cron.d/<nama>.
ENABLE_CRON="1"
CRON_FILE_NAME="rtrwnet"

# Opt-in phpMyAdmin.
ENABLE_PHPMYADMIN="0"
PHPMYADMIN_URL="/phpmyadmin"
