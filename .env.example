# RTRWNet canonical runtime environment.
# Copy this file to .env in the project root, then fill only the sections you use.
# Legacy alias env vars are intentionally omitted from this contract.

# ---------------------------------------------------------------------------
# Required Core Runtime
# ---------------------------------------------------------------------------
CI_ENV="production"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="ganti_nama_database"
DB_USER="ganti_user_database"
DB_PASS="ganti_password_database"
CI_ENCRYPTION_KEY="ganti_dengan_app_key_acak_dan_panjang"

# ---------------------------------------------------------------------------
# Required Security Tokens
# ---------------------------------------------------------------------------
# Wajib untuk callback/provisioning Telegram yang sudah di-hardening.
PROVISIONING_CALLBACK_SECRET="ganti_dengan_secret_callback"
TELEGRAM_WEBHOOK_SECRET="ganti_dengan_secret_webhook"
CRON_TOKEN="ganti_dengan_token_cron_umum"
MONITORING_CRON_TOKEN="ganti_dengan_token_cron_monitoring"

# ---------------------------------------------------------------------------
# Optional App / Security Tunables
# ---------------------------------------------------------------------------
APP_FORCE_HTTPS="0"
APP_LOG_THRESHOLD="1"
APP_TRUSTED_PROXIES=""
APP_BRAND_NAME="RTRWNet"
APP_BRAND_TAGLINE="ISP Operations Platform"
APP_BRAND_COMPANY="RTRWNet Operator"
COMPANY_NAME=""
COMPANY_TAGLINE=""
COMPANY_ADDRESS=""
COMPANY_PHONE=""
COMPANY_EMAIL="billing@example.invalid"
COMPANY_WEBSITE=""
AUTH_LOGIN_MAX_ATTEMPTS="8"
AUTH_LOGIN_WINDOW_SECONDS="900"
AUTH_LOGIN_LOCK_SECONDS="900"
AUTH_SESSION_IDLE_TIMEOUT="600"
CRON_NOTIFICATION_KEY=""

# ---------------------------------------------------------------------------
# Optional MikroTik Global Fallback
# ---------------------------------------------------------------------------
# Dipakai hanya jika credential/router per-record di database tidak tersedia.
MIKROTIK_HOST=""
MIKROTIK_PORT="8728"
MIKROTIK_USER=""
MIKROTIK_PASS=""
MIKROTIK_SSL="false"
MIKROTIK_TIMEOUT="5"
MIKROTIK_RETRY_MAX="3"
MIKROTIK_RETRY_DELAY="1"
MIKROTIK_ISOLIR_LIST="ISOLIR"
BILLING_APPLY_MIKROTIK_ON_MARK_PAID="0"

# ---------------------------------------------------------------------------
# Optional Pusher Integration
# ---------------------------------------------------------------------------
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap1"
PUSHER_USE_TLS="true"
PUSHER_CHANNEL_PUBLIC="superapps-channel"
PUSHER_CHANNEL_PRIVATE_PREFIX="private-user-"
PUSHER_EVENT_NEW_NOTIFICATION="new-notification"

# ---------------------------------------------------------------------------
# Optional Telegram Integration
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""

# ---------------------------------------------------------------------------
# Optional Async Queue / Redis
# ---------------------------------------------------------------------------
# Fresh install aman default: database queue. Installer bisa override ke redis.
QUEUE_DRIVER="database"
QUEUE_ENABLE_ASYNC="1"
QUEUE_NAME="default"
QUEUE_POLL_SLEEP_SECONDS="1"
QUEUE_POP_TIMEOUT_SECONDS="2"
QUEUE_WORKER_MEMORY_LIMIT_MB="256"
QUEUE_DEFAULT_MAX_ATTEMPTS="5"
QUEUE_BACKOFF_BASE_SECONDS="5"
QUEUE_BACKOFF_MAX_SECONDS="300"
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_DB="0"
REDIS_TIMEOUT="2.0"
REDIS_PASSWORD=""
REDIS_PREFIX="rtrwnet:"

# ---------------------------------------------------------------------------
# Optional TR-069 / FreeACS Integration
# ---------------------------------------------------------------------------
# Isi eksplisit jika integration dipakai; jangan mengandalkan runtime default.
TR069_API_TOKEN=""
TR069_API_BASIC_ENABLED="0"
TR069_API_BASIC_USER=""
TR069_API_BASIC_PASS=""
FREEACS_MODE="soap"
FREEACS_SOAP_URL=""
FREEACS_SOAP_LOGIN_USER=""
FREEACS_SOAP_LOGIN_PASS=""
FREEACS_HTTP_USER=""
FREEACS_HTTP_PASS=""
FREEACS_REST_BASE_URL=""
FREEACS_REST_TOKEN=""
FREEACS_TIMEOUT="20"
FREEACS_VERIFY_SSL="0"
TR069_TASK_RATE_LIMIT_SECONDS="2"

# ---------------------------------------------------------------------------
# Optional GenieACS General Tunables
# ---------------------------------------------------------------------------
# Endpoint ACS/NBI per-router tetap dikelola dari database.
GENIEACS_TIMEOUT="20"
GENIEACS_VERIFY_SSL="0"
GENIEACS_VPARAM_SYNC_ENABLED="1"
GENIEACS_VPARAM_SOURCE="alijayanet"
GENIEACS_VPARAM_BASE_DIR="docs/genieacs_virtual_parameters"
GENIEACS_VPARAM_NDJSON_PATH=""
GENIEACS_VPARAM_JSON_ARRAY_PATH=""
GENIEACS_VPARAM_MANIFEST_PATH=""
GENIEACS_VPARAM_MONGO_DB="genieacs"
