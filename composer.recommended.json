{
  "name": "nawacore/superapps",
  "description": "SuperApps Nawacore based on CodeIgniter 3",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=7.4",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.8",
    "evilfreelancer/routeros-api-php": "^1.6",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.6",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "App\\Libraries\\": "application/libraries/",
      "App\\Cronjobs\\": "application/cronjobs/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
